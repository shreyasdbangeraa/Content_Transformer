# AI Content Transformer — Environment Configuration Example

# =============================================================================
# 1. DATABASE & SUPABASE CONFIGURATION
# =============================================================================
# For Supabase: Provide your project URL and Service / Anon key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL connection string (Supabase or Local Postgres).
# Defaults to local SQLite if left empty.
DATABASE_URL=sqlite:///./content_transformer.db

# =============================================================================
# 2. AI PROVIDER CONFIGURATION
# =============================================================================
# Provider options: "mock", "gemini", "openai"
AI_PROVIDER=mock

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=

# Hugging Face API Key for FLUX.1 image generation (https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# =============================================================================
# 3. n8n AUTOMATION & PUBLISHING WEBHOOK
# =============================================================================
# Your n8n webhook receiver URL for approved social media publishing
N8N_WEBHOOK_URL=http://localhost:5678/webhook/content-publish
N8N_WEBHOOK_SECRET=your_custom_webhook_secret_here

# =============================================================================
# 4. FRONTEND CONFIGURATION
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api
