{
  "name": "ai-content-transformer-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"FASTAPI,NEXTJS\" -c \"cyan,blue\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "next dev -p 3000",
    "dev:backend": "python -m uvicorn app.main:app --reload --port 8000 --app-dir ../backend",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.7",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
