      "parameters": {
        "jsCode": "const items = $input.all();\nconst item = items.length > 0 ? items[0].json : {};\nconst src = $('17 - Prepare For Publishing').first().json || {};\nconst hasApiError = item.error && (item.error.message || item.error.type);\nconst isSuccess = !!(item.id && !hasApiError);\nlet errMsg = '';\nif (!isSuccess) {\n  if (hasApiError) { errMsg = 'Instagram API error: ' + (item.error.message || JSON.stringify(item.error)); }\n  else if (!item.id) { errMsg = 'Instagram not configured - no credential or account ID'; }\n  else { errMsg = 'Instagram publishing failed'; }\n}\nreturn [{ json: {\n  platform: 'instagram',\n  status: isSuccess ? 'PUBLISHED' : 'FAILED',\n  platform_post_id: isSuccess ? String(item.id || '') : '',\n  error: errMsg,\n  post_id: String(src.post_id || ''),\n  topic: String(src.topic || ''),\n} }];"
