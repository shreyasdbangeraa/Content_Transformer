    {
      "parameters": {
        "jsCode": "const items = $input.all().map(function(i) { return i.json; });\nconst li = items.find(function(i) { return i.platform === 'linkedin'; }) || {};\nconst ig = items.find(function(i) { return i.platform === 'instagram'; }) || {};\nconst liOk = li.status === 'PUBLISHED';\nconst igOk = ig.status === 'PUBLISHED';\nlet finalStatus;\nif (liOk && igOk) finalStatus = 'PUBLISHED';\nelse if (liOk || igOk) finalStatus = 'PARTIALLY_PUBLISHED';\nelse finalStatus = 'FAILED';\nconst now = new Date().toISOString();\nconst errParts = [];\nif (!liOk && li.error) errParts.push('LinkedIn: ' + li.error);\nif (!igOk && ig.error) errParts.push('Instagram: ' + ig.error);\nreturn [{ json: { post_id: li.post_id || ig.post_id || '', topic: li.topic || ig.topic || '', final_status: finalStatus, linkedin_status: liOk ? 'PUBLISHED' : 'FAILED', instagram_status: igOk ? 'PUBLISHED' : 'FAILED', linkedin_post_id: liOk ? (li.platform_post_id || '') : '', instagram_post_id: igOk ? (ig.platform_post_id || '') : '', error_message: errParts.join(' | '), published_at: (liOk || igOk) ? now : '', any_failed: (!liOk || !igOk) } }];"
      },
