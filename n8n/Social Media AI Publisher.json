      "parameters": {
        "jsCode": "function extractText(output) {\n  if (!output) return '';\n  if (typeof output === 'string') return output.trim();\n  if (Array.isArray(output)) {\n    for (var i = 0; i < output.length; i++) {\n      var block = output[i];\n      if (!block) continue;\n      if (block.type === 'message' && Array.isArray(block.content)) {\n        for (var j = 0; j < block.content.length; j++) {\n          var c = block.content[j];\n          if (c && c.type === 'output_text' && c.text) return String(c.text).trim();\n          if (c && typeof c.text === 'string') return c.text.trim();\n        }\n      }\n      if (block.type === 'output_text' && block.text) return String(block.text).trim();\n      if (typeof block.text === 'string') return block.text.trim();\n    }\n    return JSON.stringify(output);\n  }\n  return String(output).trim();\n}\nvar allItems = $input.all();\nif (allItems.length === 0) return [];\nvar agentJson = allItems[0].json;\nvar rawOutput = extractText(agentJson.output);\nvar postCtx = {};\ntry { postCtx = $('02 - Set Post Context').first().json || {}; } catch(e) {}\nvar text = rawOutput.trim();\nif (text.indexOf('```json') === 0) { text = text.slice(7); }\nelse if (text.indexOf('```') === 0) { text = text.slice(3); }\nif (text.lastIndexOf('```') === text.length - 3) { text = text.slice(0, -3); }\ntext = text.trim();\nvar parsed = {};\ntry {\n  var candidate = JSON.parse(text);\n  if (candidate && typeof candidate === 'object' && !Array.isArray(candidate)) { parsed = candidate; }\n} catch (e1) {\n  var start = rawOutput.indexOf('{');\n  var end = rawOutput.lastIndexOf('}');\n  if (start !== -1 && end > start) {\n    try {\n      var candidate2 = JSON.parse(rawOutput.slice(start, end + 1));\n      if (candidate2 && typeof candidate2 === 'object' && !Array.isArray(candidate2)) { parsed = candidate2; }\n    } catch (e2) {}\n  }\n}\nvar hashtagsArr = Array.isArray(parsed.hashtags) ? parsed.hashtags : [];\nvar hashtagsStr = hashtagsArr.map(function(h) { return String(h).charAt(0) === '#' ? String(h) : '#' + String(h); }).join(' ');\nreturn [{ json: {\n  post_id: String(postCtx.post_id || ''),\n  topic: String(postCtx.topic || ''),\n  source_url: String(postCtx.source_url || ''),\n  source_content: String(postCtx.source_content || ''),\n  image_url: String(postCtx.image_url || ''),\n  content_type: String(postCtx.content_type || 'article'),\n  linkedin_caption: String(parsed.linkedin_caption || ''),\n  instagram_caption: String(parsed.instagram_caption || ''),\n  hashtags: hashtagsStr || postCtx.hashtags || '#AI #Innovation',\n  image_prompt: String(parsed.image_prompt || ('Photorealistic professional scene about ' + String(postCtx.topic || 'technology') + ', modern office setting, soft lighting')),\n  linkedin_post_id: String(postCtx.linkedin_post_id || ''),\n  instagram_post_id: String(postCtx.instagram_post_id || ''),\n} }];"
      },
