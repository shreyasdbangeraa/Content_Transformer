      "parameters": {
        "jsCode": "const now = new Date();\nconst IST_OFFSET_MS = 5.5 * 60 * 60 * 1000;\nconst nowIST = new Date(now.getTime() + IST_OFFSET_MS);\nconst todayStr = nowIST.toISOString().slice(0, 10);\nconst currentTimeStr = nowIST.toISOString().slice(11, 16);\nconst items = $input.all();\nconst duePosts = items.filter(function(item) {\n  const row = item.json;\n  if (row.status !== 'PENDING') return false;\n  if (row.linkedin_post_id && row.instagram_post_id) return false;\n  if (!row.scheduled_date || !row.scheduled_time) return false;\n  const schedDate = String(row.scheduled_date).trim().slice(0, 10);\n  const schedTime = String(row.scheduled_time).trim().slice(0, 5);\n  if (schedDate < todayStr) return true;\n  if (schedDate === todayStr && schedTime <= currentTimeStr) return true;\n  return false;\n});\nif (duePosts.length === 0) return [];\nreturn [duePosts[0]];"
      },
