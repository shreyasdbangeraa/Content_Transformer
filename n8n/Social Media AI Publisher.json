    {
      "parameters": {
        "jsCode": "const items = $input.all().map(function(i) { return i.json; });\nconst li = items.find(function(i) { return i.platform === 'linkedin'; }) || {};\nconst ig = items.find(function(i) { return i.platform === 'instagram'; }) || {};\nconst liOk = li.status === 'PUBLISHED';\nconst igOk = ig.status === 'PUBLISHED';\nlet finalStatus;\nif (liOk && igOk) finalStatus = 'PUBLISHED';\nelse if (liOk || igOk) finalStatus = 'PARTIALLY_PUBLISHED';\nelse finalStatus = 'PUBLISHED';\nconst now = new Date().toISOString();\nconst errParts = [];\nif (!liOk && li.error) errParts.push('LinkedIn: ' + li.error);\nif (!igOk && ig.error) errParts.push('Instagram: ' + ig.error);\nreturn [{ json: {\n  post_id: li.post_id || ig.post_id || '',\n  topic: li.topic || ig.topic || '',\n  final_status: finalStatus,\n  linkedin_status: liOk ? 'PUBLISHED' : (li.status || 'READY'),\n  instagram_status: igOk ? 'PUBLISHED' : (ig.status || 'READY'),\n  linkedin_post_id: liOk ? (li.platform_post_id || '') : '',\n  instagram_post_id: igOk ? (ig.platform_post_id || '') : '',\n  error_message: errParts.join(' | '),\n  published_at: now,\n  any_failed: (!liOk && !igOk)\n} }];"
      },
