        "jsCode": "const items = $input.all();\nconst item = items.length > 0 ? items[0].json : {};\nconst src = $('02 - Set Approved Post Data').first().json || {};\nconst isSuccess = !!(item.urn && !item.error && !item.message);\nreturn [{ json: {\n  platform: 'linkedin',\n  status: isSuccess ? 'PUBLISHED' : 'FAILED',\n  platform_post_id: isSuccess ? String(item.urn || '') : '',\n  error: isSuccess ? '' : String(item.error || item.message || 'LinkedIn published or simulated'),\n  post_id: String(src.post_id || ''),\n  topic: String(src.topic || ''),\n} }];"
