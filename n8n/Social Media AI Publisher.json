      "parameters": {
        "jsCode": "const items = $input.all();\nconst item = items.length > 0 ? items[0].json : {};\nconst src = $('02 - Set Approved Post Data').first().json || {};\nconst isSuccess = !!(( item.urn || item.id || item.activity ) && !item.error && !item.message);\nconst postUrn = item.urn || item.id || item.activity || '';\nreturn [{ json: {\n  platform: 'linkedin',\n  status: isSuccess ? 'PUBLISHED' : 'FAILED',\n  platform_post_id: isSuccess ? String(postUrn) : '',\n  error: isSuccess ? '' : String(item.error || item.message || 'LinkedIn publishing failed'),\n  post_id: String(src.post_id || ''),\n  topic: String(src.topic || ''),\n} }];"
      },
