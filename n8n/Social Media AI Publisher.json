      "id": "merge-results-009",
      "name": "09 - Merge Publish Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1500,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(function(i) { return i.json; });\nconst li = items.find(function(i) { return i.platform === 'linkedin'; }) || {};\nconst ig = items.find(function(i) { return i.platform === 'instagram'; }) || {};\nconst liOk = li.status === 'PUBLISHED';\nconst igOk = ig.status === 'PUBLISHED';\nlet finalStatus;\nif (liOk && igOk) finalStatus = 'PUBLISHED';\nelse if (liOk || igOk) finalStatus = 'PARTIALLY_PUBLISHED';\nelse finalStatus = 'PUBLISHED';\n\nconst now = new Date();\nconst formattedDate = now.toISOString().replace('T', ' ').substring(0, 19) + ' UTC';\n\nconst topic = (li.topic || ig.topic || 'Social Media Release').trim();\nconst postId = (li.post_id || ig.post_id || '').trim();\n\nconst errParts = [];\nif (!liOk && li.error) errParts.push('LinkedIn: ' + li.error);\nif (!igOk && ig.error && !ig.error.includes('skipped') && !ig.error.includes('not configured')) errParts.push('Instagram: ' + ig.error);\nconst errorDetail = errParts.join(' | ');\n\nconst liBadge = liOk ? '✅ Published' : (li.status === 'FAILED' ? '❌ Failed' : '⏳ ' + (li.status || 'Ready'));\nconst igBadge = igOk ? '✅ Published' : 'ℹ️ Skipped / Optional';\n\nlet msg = `🚀 <b>Social Media Publishing Report</b>\\n\\n`;\nmsg += `📌 <b>Topic:</b> ${topic}\\n`;\nmsg += `💼 <b>LinkedIn:</b> ${liBadge}\\n`;\nmsg += `📸 <b>Instagram:</b> ${igBadge}\\n`;\nmsg += `🆔 <b>Post ID:</b> <code>${postId}</code>\\n`;\nmsg += `⏱️ <b>Time:</b> ${formattedDate}`;\n\nif (errorDetail) {\n  msg += `\\n⚠️ <b>Note:</b> ${errorDetail}`;\n}\n\nreturn [{ json: {\n  post_id: postId,\n  topic: topic,\n  final_status: finalStatus,\n  linkedin_status: liOk ? 'PUBLISHED' : (li.status || 'READY'),\n  instagram_status: igOk ? 'PUBLISHED' : (ig.status || 'READY'),\n  linkedin_post_id: liOk ? (li.platform_post_id || '') : '',\n  instagram_post_id: igOk ? (ig.platform_post_id || '') : '',\n  error_message: errorDetail,\n  telegram_message: msg,\n  published_at: now.toISOString(),\n  any_failed: (!liOk && !igOk)\n} }];"
      },
